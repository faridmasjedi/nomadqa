# Copy this file to .env (it is ignored by git) and fill it in. In CI the same names come from the CI's secrets.

# The run itself is this user — either the user's SFDX auth URL (recommended) …
SF_AUTH_URL=
# … or the user's username and password (a login page that asks to verify the user cannot be passed)
SF_USERNAME=
SF_PASSWORD=
# https://test.salesforce.com for a sandbox or scratch org; https://login.salesforce.com (default) for production
SF_LOGIN_PAGE=https://test.salesforce.com

# More users, for tests with a "Log in" step: NOMADQA_AUTH_URL_<NAME> is the login "<name>" (SALES_REP → sales-rep)
# NOMADQA_AUTH_URL_SALES_REP=
# NOMADQA_USERNAME_SERVICE_AGENT=
# NOMADQA_PASSWORD_SERVICE_AGENT=
