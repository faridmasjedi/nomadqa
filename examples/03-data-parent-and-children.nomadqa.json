{
  "nomadqa": "test",
  "version": 1,
  "name": "Account with contacts and opportunities",
  "group": "Data",
  "cleanup": true,
  "steps": [
    {
      "action": "data",
      "recipe": {
        "name": "Demo data",
        "nodes": [
          {
            "id": "a",
            "object": "Account",
            "count": 1,
            "rules": {
              "Name": {
                "kind": "pattern",
                "value": "NomadQA Demo {0000}"
              },
              "Industry": {
                "kind": "fixed",
                "value": "Energy"
              }
            }
          },
          {
            "id": "c",
            "object": "Contact",
            "count": 3,
            "parentId": "a",
            "parentField": "AccountId",
            "rules": {
              "FirstName": {
                "kind": "auto"
              },
              "LastName": {
                "kind": "auto"
              },
              "Email": {
                "kind": "auto"
              }
            }
          },
          {
            "id": "o",
            "object": "Opportunity",
            "count": 2,
            "parentId": "a",
            "parentField": "AccountId",
            "rules": {
              "Name": {
                "kind": "pattern",
                "value": "{parent.Name} — renewal {0}"
              },
              "StageName": {
                "kind": "fixed",
                "value": "Prospecting"
              },
              "CloseDate": {
                "kind": "dates",
                "from": 10,
                "to": 60
              }
            }
          }
        ]
      }
    },
    {
      "action": "open",
      "record": "{{a-1}}"
    },
    {
      "action": "expect",
      "kind": "title",
      "value": "{{a-1.Name}}"
    },
    {
      "action": "expect",
      "kind": "field",
      "field": "Industry",
      "value": "Energy"
    },
    {
      "action": "query",
      "soql": "SELECT Id FROM Contact WHERE AccountId = '{{a-1}}'",
      "count": 3
    },
    {
      "action": "query",
      "soql": "SELECT Id FROM Opportunity WHERE AccountId = '{{a-1}}'",
      "count": 2
    },
    {
      "action": "expect",
      "kind": "text",
      "value": "Contacts (3)"
    },
    {
      "action": "expect",
      "kind": "text",
      "value": "Opportunities (2)"
    }
  ]
}
