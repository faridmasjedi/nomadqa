{
  "nomadqa": "test",
  "version": 1,
  "name": "Find a record, remember a value, use it later",
  "group": "Data",
  "cleanup": true,
  "steps": [
    {
      "action": "data",
      "recipe": {
        "name": "Demo data",
        "nodes": [
          {
            "id": "a",
            "object": "Account",
            "count": 1,
            "rules": {
              "Name": {
                "kind": "pattern",
                "value": "NomadQA Reuse {0000}"
              },
              "Industry": {
                "kind": "fixed",
                "value": "Technology"
              }
            }
          }
        ]
      }
    },
    {
      "action": "query",
      "soql": "SELECT Id, Name, Industry FROM Account WHERE Id = '{{a-1}}'",
      "count": 1,
      "save": "found"
    },
    {
      "action": "open",
      "record": "{{found}}"
    },
    {
      "action": "remember",
      "field": "Industry",
      "as": "industry"
    },
    {
      "action": "expect",
      "kind": "field",
      "field": "Industry",
      "value": "{{found.Industry}}"
    },
    {
      "action": "click",
      "label": "Edit"
    },
    {
      "action": "fill",
      "field": "Phone",
      "value": "555 0100 {{industry}}"
    },
    {
      "action": "click",
      "label": "Save"
    },
    {
      "action": "expect",
      "kind": "toast",
      "value": "was saved"
    },
    {
      "action": "expect",
      "kind": "field",
      "field": "Phone",
      "op": "contains",
      "value": "555 0100 Technology"
    }
  ]
}
