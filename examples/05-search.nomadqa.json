{
  "nomadqa": "test",
  "version": 1,
  "name": "Search and choose",
  "group": "Search",
  "cleanup": true,
  "steps": [
    {
      "action": "data",
      "recipe": {
        "name": "Demo data",
        "nodes": [
          {
            "id": "a",
            "object": "Account",
            "count": 1,
            "rules": {
              "Name": {
                "kind": "pattern",
                "value": "NomadQA Findme {0000}"
              },
              "Industry": {
                "kind": "fixed",
                "value": "Energy"
              }
            }
          }
        ]
      }
    },
    {
      "action": "open",
      "path": "/lightning/o/Account/list"
    },
    {
      "action": "search",
      "box": "Search this list...",
      "text": "{{a-1.Name}}"
    },
    {
      "action": "expect",
      "kind": "text",
      "value": "{{a-1.Name}}"
    },
    {
      "action": "expect",
      "kind": "no-text",
      "value": "Aperture Science"
    },
    {
      "action": "open",
      "path": "/lightning/page/home"
    },
    {
      "action": "wait",
      "until": "load"
    },
    {
      "action": "search",
      "text": "{{a-1.Name}}",
      "choose": "{{a-1.Name}}"
    },
    {
      "action": "expect",
      "kind": "title",
      "value": "{{a-1.Name}}"
    }
  ]
}
